{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python -m pip install --break-system-packages -r docs/requirements.txt",
  "buildCommand": "python -m mkdocs build --strict",
  "outputDirectory": "site",
  "ignoreCommand": "exit 1",
  "redirects": [
    {
      "source": "/BETA_DOWNLOAD",
      "destination": "/#download",
      "permanent": true
    },
    {
      "source": "/BETA_DOWNLOAD/",
      "destination": "/#download",
      "permanent": true
    },
    {
      "source": "/BETA_TESTER_QUICKSTART",
      "destination": "/#use",
      "permanent": true
    },
    {
      "source": "/BETA_TESTER_QUICKSTART/",
      "destination": "/#use",
      "permanent": true
    },
    {
      "source": "/BETA_FAQ",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/BETA_FAQ/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/BETA_KNOWN_ISSUES",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/BETA_KNOWN_ISSUES/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tutorials/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/BETA_TESTER_PLAN",
      "destination": "/#use",
      "permanent": true
    },
    {
      "source": "/BETA_TESTER_PLAN/",
      "destination": "/#use",
      "permanent": true
    },
    {
      "source": "/MACOS_INSTALLER",
      "destination": "/#download",
      "permanent": true
    },
    {
      "source": "/MACOS_INSTALLER/",
      "destination": "/#download",
      "permanent": true
    }
  ]
}
