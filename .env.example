STREAMCLIP_ENVIRONMENT=development
STREAMCLIP_DATABASE__URL=postgresql+asyncpg://streamclip:streamclip@localhost:5432/streamclip
STREAMCLIP_DATABASE__SYNC_URL=postgresql+psycopg://streamclip:streamclip@localhost:5432/streamclip
STREAMCLIP_REDIS__URL=redis://localhost:6379/0
STREAMCLIP_CELERY__BROKER_URL=redis://localhost:6379/1
STREAMCLIP_CELERY__RESULT_BACKEND=redis://localhost:6379/2
STREAMCLIP_STORAGE__BACKEND=minio
STREAMCLIP_STORAGE__ENDPOINT_URL=http://localhost:9000
STREAMCLIP_STORAGE__PUBLIC_BASE_URL=http://localhost:9000
STREAMCLIP_STORAGE__BUCKET=streamclip
STREAMCLIP_STORAGE__ACCESS_KEY=streamclip
STREAMCLIP_STORAGE__SECRET_KEY=streamclip_secret
STREAMCLIP_RATE_LIMIT__ENABLED=false
STREAMCLIP_AUTH__SECRET_KEY=change-me-in-production-use-openssl-rand
STREAMCLIP_AUTH__ALLOW_ANONYMOUS=true
# STREAMCLIP_WEBHOOKS__ENABLED=true
# STREAMCLIP_WEBHOOKS__URL=https://your-app.com/hooks/streamclip
# STREAMCLIP_WEBHOOKS__SECRET=your-hmac-secret
# STREAMCLIP_OBSERVABILITY__OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
