# StreamClip production environment
# Copy to .env.production and fill secrets before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# With NVIDIA GPU worker (queue isolation):
#   Set STREAMCLIP_WORKER_QUEUES=default
#   docker compose -f docker-compose.prod.yml --env-file .env.production --profile gpu up -d

STREAMCLIP_VERSION=latest
# Registry prefix for GHCR images — override if pulling from a fork/non-canonical org
# e.g. ghcr.io/your-org for a forked repo
STREAMCLIP_IMAGE_PREFIX=ghcr.io/streamclip

# Required secrets (run .\scripts\verify_production_secrets.ps1 before first deploy)
POSTGRES_PASSWORD=change-me-strong-password
# Required by docker-compose.prod.yml and mapped to STREAMCLIP_AUTH__SECRET_KEY.
# Must be >=32 chars and not a placeholder. Generate: openssl rand -hex 32
STREAMCLIP_AUTH_SECRET_KEY=change-me-use-openssl-rand-hex-32
MINIO_ROOT_USER=streamclip
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Production hardening (recommended)
STREAMCLIP_ENVIRONMENT=production
STREAMCLIP_RATE_LIMIT__ENABLED=true
STREAMCLIP_LOG_JSON=true
# Generate: openssl rand -hex 16 — required for Prometheus scrape from Docker bridge
STREAMCLIP_OBSERVABILITY__METRICS_API_KEY=

# Optional commerce SKUs
# STREAMCLIP_FEATURES__AUDIO_INGEST=false
# STREAMCLIP_COMMERCE__AUDIO_INGEST_VARIANT_IDS=12345,67890

POSTGRES_USER=streamclip
POSTGRES_DB=streamclip
MINIO_BUCKET=streamclip
# MUST be a browser-reachable URL for your MinIO/S3 endpoint (not the internal
# Docker hostname `minio:9000`) — used to sign presigned GET/PUT URLs for
# playback, thumbnails, downloads, and uploads. Set this to your public
# storage domain/IP (e.g. https://storage.yourdomain.com) in real deployments.
STREAMCLIP_PUBLIC_BASE_URL=http://localhost:9000
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
STREAMCLIP_AUTH_ALLOW_ANONYMOUS=true

# Worker queues: default = CPU worker only (safe). With --profile gpu, set to "default"
# so transcribe/reframe run on gpu-worker. Without GPU profile, use "default,gpu" to
# process GPU tasks on CPU (slow but functional).
STREAMCLIP_WORKER_QUEUES=default

# Distribution (generate token key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
STREAMCLIP_DISTRIBUTION__TOKEN_ENCRYPTION_KEY=
STREAMCLIP_DISTRIBUTION__WEB_ORIGIN=http://localhost:3000
STREAMCLIP_DISTRIBUTION__YOUTUBE_PUBLISH_ENABLED=true
STREAMCLIP_DISTRIBUTION__TIKTOK_PUBLISH_ENABLED=false
STREAMCLIP_DISTRIBUTION__YOUTUBE_CLIENT_ID=
STREAMCLIP_DISTRIBUTION__YOUTUBE_CLIENT_SECRET=
STREAMCLIP_DISTRIBUTION__TIKTOK_CLIENT_KEY=
STREAMCLIP_DISTRIBUTION__TIKTOK_CLIENT_SECRET=

# Lemon Squeezy commerce (optional)
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_API_KEY=
# STREAMCLIP_COMMERCE__LEMON_SQUEEZY_BETA_VARIANT_ID=
# STREAMCLIP_COMMERCE__LEMON_SQUEEZY_PRO_VARIANT_ID=
# STREAMCLIP_COMMERCE__LEMON_SQUEEZY_CHECKOUT_URL=

# --- Operator notify (recommended for Phase 0; docs/OPS_ALERTING.md) ---
# OPS_WEBHOOK_URL ≠ STREAMCLIP_WEBHOOKS__URL. Ops posts unsigned JSON
# (Content-Type: application/json, User-Agent: StreamClip-Ops/1.0) for
# bug_report / beta_feedback / job_failed / stack_degraded. Prefer Zapier/Make
# Catch Hook or custom JSON inbox — not a raw Discord/Slack incoming webhook.
# Set on api + worker + beat. Never commit a real production URL.
# Mock egress (no secret): .\scripts\verify_ops_webhook.ps1 -DryRun ; .\scripts\verify_ops_webhook.ps1
# OPS_WEBHOOK_URL only (legacy N8N_* alias removed).
# OPS_WEBHOOK_URL=https://hooks.example.com/streamclip-ops
#
# SMTP: bug-report email (BUG_REPORT_TO), password reset, LS license fallback.
# Set on api + worker. Forms always persist in bug_reports without SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=streamclip@example.com
# SMTP_STARTTLS=true
# BUG_REPORT_TO=bugs@example.com
# Resend (verify sending domain first; SMTP_USER must be "resend"):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=<resend_api_key>
# SMTP_FROM=alerts@your-verified-domain.example
# SMTP_STARTTLS=true
# BUG_REPORT_TO=ops@your-domain.example

# Optional Sentry (API + Celery workers)
# STREAMCLIP_OBSERVABILITY__SENTRY_DSN=https://...@o....ingest.sentry.io/...
