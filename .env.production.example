# StreamClip production environment
# Copy to .env.production and fill secrets before: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

STREAMCLIP_VERSION=latest

# Required secrets
POSTGRES_PASSWORD=change-me-strong-password
STREAMCLIP_AUTH_SECRET_KEY=change-me-use-openssl-rand-hex-32
MINIO_ROOT_USER=streamclip
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Optional overrides
POSTGRES_USER=streamclip
POSTGRES_DB=streamclip
MINIO_BUCKET=streamclip
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
STREAMCLIP_AUTH_ALLOW_ANONYMOUS=true

# Distribution (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
STREAMCLIP_DISTRIBUTION__TOKEN_ENCRYPTION_KEY=
STREAMCLIP_DISTRIBUTION__WEB_ORIGIN=http://localhost:3000
STREAMCLIP_DISTRIBUTION__YOUTUBE_PUBLISH_ENABLED=true
STREAMCLIP_DISTRIBUTION__TIKTOK_PUBLISH_ENABLED=false

# Lemon Squeezy commerce (optional)
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_API_KEY=

# Stripe cloud metering (see docs/cloud-deploy.md)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
