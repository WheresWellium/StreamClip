{
  "version": 1,
  "hooks": {
    "preCompact": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/pre-compact.ps1"
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/stop-compaction.ps1"
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/continual-learning-stop.ps1"
      }
    ],
    "subagentStop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/subagent-stop.ps1",
        "matcher": "explore|generalPurpose|shell|docs-researcher"
      }
    ]
  }
}
