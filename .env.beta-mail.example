# Phase 0 beta mail — Microsoft 365 / Outlook SMTP (operator only)
# Copy to .env.beta-mail (gitignored), fill SMTP_PASSWORD, then:
#   python scripts/send_beta_test_info_emails.py --csv cohort.csv \
#       --keys-csv tmp/beta-keys.csv --env-file .env.beta-mail --send
#
# Sender: wheres@wellium.work (Microsoft 365 mailbox)
# Requires SMTP AUTH enabled for the mailbox (M365 admin → user → Mail → Manage email apps).

# wellium.work mailbox uses implicit SSL on port 465 (see provider IMAP/SMTP panel).
SMTP_HOST=mail.wellium.work
SMTP_PORT=465
SMTP_USER=wheres@wellium.work
SMTP_PASSWORD=
SMTP_FROM=wheres@wellium.work
SMTP_SSL=true
SMTP_STARTTLS=false

# Optional — forward in-app bug reports to the same inbox when running Docker stack:
# BUG_REPORT_TO=wheres@wellium.work
