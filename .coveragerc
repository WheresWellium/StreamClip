[run]
source = backend,core
# Enable branch measurement for hot-path gate (see docs/BETA_GO_LIVE.md):
# branch = True

[report]
# Ratchet toward 100% (the "110% plan" — line coverage caps at 100%; stretch goal is
# 100% line + hot-path branches + Playwright smoke). Full-suite was 95.4% on 2026-07-06.
fail_under = 95
show_missing = true
