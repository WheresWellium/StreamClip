STREAMCLIP_ENVIRONMENT=development
STREAMCLIP_DATABASE__URL=postgresql+asyncpg://streamclip:streamclip@localhost:5432/streamclip
STREAMCLIP_DATABASE__SYNC_URL=postgresql+psycopg://streamclip:streamclip@localhost:5432/streamclip
STREAMCLIP_REDIS__URL=redis://localhost:6379/0
STREAMCLIP_CELERY__BROKER_URL=redis://localhost:6379/1
STREAMCLIP_CELERY__RESULT_BACKEND=redis://localhost:6379/2
STREAMCLIP_STORAGE__BACKEND=minio
STREAMCLIP_STORAGE__ENDPOINT_URL=http://localhost:9000
STREAMCLIP_STORAGE__PUBLIC_BASE_URL=http://localhost:9000
STREAMCLIP_STORAGE__BUCKET=streamclip
STREAMCLIP_STORAGE__ACCESS_KEY=streamclip
STREAMCLIP_STORAGE__SECRET_KEY=streamclip_secret
# Rate limiting defaults to ON in code — this opt-out is for local dev only.
STREAMCLIP_RATE_LIMIT__ENABLED=false
# REQUIRED in production — generate with: openssl rand -hex 32
# Leaving as the default triggers a CRITICAL log warning at startup.
STREAMCLIP_AUTH__SECRET_KEY=change-me-in-production-use-openssl-rand
STREAMCLIP_AUTH__ALLOW_ANONYMOUS=true
STREAMCLIP_AUTH__DEVICE_SCOPED_ANONYMOUS=true
# STREAMCLIP_WEBHOOKS__ENABLED=true
# STREAMCLIP_WEBHOOKS__URL=https://your-app.com/hooks/streamclip
# STREAMCLIP_WEBHOOKS__SECRET=your-hmac-secret
# Social distribution (OAuth + publish; Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# NOTE: docker-compose.yml (dev) hardcodes a DEV-ONLY key for api/worker/gpu-worker already.
# Set this only if running api/worker outside Docker. Never reuse a dev key in production.
# STREAMCLIP_DISTRIBUTION__TOKEN_ENCRYPTION_KEY=
# STREAMCLIP_DISTRIBUTION__WEB_ORIGIN=http://localhost:3000
# STREAMCLIP_DISTRIBUTION__YOUTUBE_PUBLISH_ENABLED=true
# STREAMCLIP_DISTRIBUTION__TIKTOK_PUBLISH_ENABLED=false
# Lemon Squeezy commerce (optional)
# STREAMCLIP_COMMERCE__LEMON_SQUEEZY_WEBHOOK_SECRET=
# STREAMCLIP_COMMERCE__LEMON_SQUEEZY_API_KEY=
# Metrics auth (optional) — if set, /metrics requires this as Bearer token or X-Metrics-Key header.
# In non-dev environments without a key, /metrics is restricted to loopback (127.0.0.1).
# Generate with: openssl rand -hex 16
# STREAMCLIP_OBSERVABILITY__METRICS_API_KEY=

# Bug report email notifications (optional — reports always persist in bug_reports table)
# Without SMTP_HOST + BUG_REPORT_TO, the in-app form saves locally but sends no email.
# SMTP runs on the Celery worker — set these on api + worker (see docker-compose.yml).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=streamclip@example.com
# SMTP_STARTTLS=true
# BUG_REPORT_TO=bugs@example.com

# n8n ops webhook (optional — routes bug reports + beta feedback to your studio inbox via n8n)
# Destination email is configured ONLY in n8n, never here. See docs/OPS_N8N_SETUP.md (internal).
# N8N_OPS_WEBHOOK_URL=https://your-n8n.example.com/webhook/streamclip-ops
